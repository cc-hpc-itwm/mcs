chunk=$(
  ${MCS_TEST_SHARE_SERVICE_BIN_CREATE}                               \
    --share-service-path "${MCS_TEST_SHARE_SERVICE_PATH}"            \
    --size 16                                                        \
    --storage "SHMEM (Prefix \"${MCS_TEST_SHARE_SERVICE_TEST_SHMEM_PREFIX}\", Limit 16)"
)

${MCS_TEST_SHARE_SERVICE_BIN_CAT} --chunk "${chunk}" | xxd -p
echo ".123456789.1234" |
  ${MCS_TEST_SHARE_SERVICE_BIN_WRITE} --chunk "${chunk}"
${MCS_TEST_SHARE_SERVICE_BIN_CAT} --chunk "${chunk}"

${MCS_TEST_SHARE_SERVICE_BIN_REMOVE} --chunk "${chunk}"
${MCS_TEST_SHARE_SERVICE_BIN_REMOVE} --chunk "${chunk}"              \
  && exit 1 || echo "^ expected error"
