# usage:
#   wait max_tests command [args...]
#
# waits at most max_tests times between 0.1 and 0.9 seconds until
# the command returns 0.
# If the command does not return 0 after max_tests attempts
# the function exits with 1.
#
# Examples:
#  wait 50 test -s /some/file
#  wait 50 mountpoint -q /some/mountpoint
#  wait 50 grep -q "pattern" /some/file
#
function wait()
{
  max=${1}; shift
  i=0
  while ! eval "${@}"
  do
    sleep 0.$((1 + RANDOM % 9))
    i=$((i+1))
    if [ $i -gt $max ]
    then
      echo "wait failed: ${@}"
      exit 1
    fi
  done
}
